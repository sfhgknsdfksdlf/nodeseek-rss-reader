{
  "name": "ingest-message.buildIngestMessages",
  "module": "ingest-message",
  "export": "buildIngestMessages",
  "cases": [
    {
      "name": "empty input yields no messages, oversize, or invalid items",
      "args": [
        [],
        {
          "syncRunId": "run-1",
          "feedUrl": "https://rss.nodeseek.com/",
          "enqueuedAt": "2026-11-22T00:00:00.000Z"
        }
      ],
      "expect": {
        "messages": [],
        "oversize": [],
        "invalid": []
      }
    },
    {
      "name": "splits 3 short items into 2+1 when maxItems=2 and keeps input order",
      "args": [
        [
          {
            "guid": "g1",
            "chunk": "a"
          },
          {
            "guid": "g2",
            "chunk": "b"
          },
          {
            "guid": "g3",
            "chunk": "c"
          }
        ],
        {
          "syncRunId": "run-1",
          "feedUrl": "https://rss.nodeseek.com/",
          "enqueuedAt": "2026-11-22T00:00:00.000Z",
          "maxItems": 2
        }
      ],
      "expect": {
        "messages": [
          {
            "v": 1,
            "kind": "rss-ingest",
            "syncRunId": "run-1",
            "source": "cron",
            "feedUrl": "https://rss.nodeseek.com/",
            "firstSyncCandidate": false,
            "maxNewPosts": null,
            "items": [
              {
                "guid": "g1",
                "chunk": "a"
              },
              {
                "guid": "g2",
                "chunk": "b"
              }
            ],
            "enqueuedAt": "2026-11-22T00:00:00.000Z"
          },
          {
            "v": 1,
            "kind": "rss-ingest",
            "syncRunId": "run-1",
            "source": "cron",
            "feedUrl": "https://rss.nodeseek.com/",
            "firstSyncCandidate": false,
            "maxNewPosts": null,
            "items": [
              {
                "guid": "g3",
                "chunk": "c"
              }
            ],
            "enqueuedAt": "2026-11-22T00:00:00.000Z"
          }
        ],
        "oversize": [],
        "invalid": []
      }
    },
