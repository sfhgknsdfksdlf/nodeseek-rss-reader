{
  "name": "rss.parseChunkFull guid hint reuse and mismatch reporting",
  "module": "rss",
  "export": "parseChunkFull",
  "cases": [
    {
      "name": "no hint parses the authoritative guid",
      "args": [
        "<item><guid>g1</guid><title>T</title><link>https://example.com/1</link><description>hello</description><pubDate>2024-01-01T00:00:00Z</pubDate><category>tech</category><dc:creator>bob</dc:creator></item>"
      ],
      "expect": {
        "item": {
          "guid": "g1",
          "title": "T",
          "link": "https://example.com/1",
          "contentHtml": "hello",
          "contentText": "hello",
          "author": "bob",
          "board": "tech",
          "publishedAt": "2024-01-01T00:00:00.000Z"
        },
        "guidMismatch": false
      }
    },
    {
      "name": "matching hint reports no mismatch",
      "args": [
        "<item><guid>g1</guid><title>T</title><link>https://example.com/1</link><description>hello</description><pubDate>2024-01-01T00:00:00Z</pubDate><category>tech</category><dc:creator>bob</dc:creator></item>",
        "g1"
      ],
      "expect": {
        "item": {
          "guid": "g1",
          "title": "T",
          "link": "https://example.com/1",
          "contentHtml": "hello",
          "contentText": "hello",
          "author": "bob",
          "board": "tech",
          "publishedAt": "2024-01-01T00:00:00.000Z"
        },
        "guidMismatch": false
      }
    },
    {
      "name": "different hint keeps the authoritative parsed guid and reports mismatch",
      "args": [
        "<item><guid>g1</guid><title>T</title><link>https://example.com/1</link><description>hello</description><pubDate>2024-01-01T00:00:00Z</pubDate><category>tech</category><dc:creator>bob</dc:creator></item>",
        "other-guid"
      ],
      "expect": {
        "item": {
          "guid": "g1",
          "title": "T",
          "link": "https://example.com/1",
          "contentHtml": "hello",
          "contentText": "hello",
          "author": "bob",
          "board": "tech",
          "publishedAt": "2024-01-01T00:00:00.000Z"
        },
        "guidMismatch": true
      }
    }
  ]
}
