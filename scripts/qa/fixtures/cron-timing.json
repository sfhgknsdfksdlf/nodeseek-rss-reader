{
  "name": "observability.shouldRecordCronTiming truth table",
  "module": "observability",
  "export": "shouldRecordCronTiming",
  "cases": [
    {
      "name": "samples a successful run below the 1/10 threshold",
      "args": [false, 0.09],
      "expect": true
    },
    {
      "name": "does not sample a successful run at exactly 0.10",
      "args": [false, 0.1],
      "expect": false
    },
    {
      "name": "does not sample a successful run above the threshold",
      "args": [false, 0.99],
      "expect": false
    },
    {
      "name": "always records a forced (failed) run",
      "args": [true, 0.99],
      "expect": true
    }
  ]
}
